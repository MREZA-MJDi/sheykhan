APP_NAME=Sheykhan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Dedicated HMAC key for deterministic national-ID lookup (keep stable)
NATIONAL_ID_HMAC_KEY=

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Checkout remains disabled until all bank details are supplied and legal documents are published.
SHEIKHAN_TRANSFER_BANK_NAME=
SHEIKHAN_TRANSFER_ACCOUNT_HOLDER=
SHEIKHAN_TRANSFER_IBAN=
SHEIKHAN_TRANSFER_ACCOUNT_NUMBER=

# Set to the Ghostscript executable path on the server when PDF watermarking is enabled.
PDF_WATERMARK_BINARY=gs

# Cloudflare Turnstile anti-bot protection for public registration.
# Enable only after adding the site key and secret key from the Cloudflare dashboard.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Search Console read-only reporting. Keep credentials only in the private server .env.
# OAuth scope: https://www.googleapis.com/auth/webmasters.readonly
# Property: https://example.com/ or sc-domain:example.com (must be verified in Search Console).
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=

# SpotPlayer DRM. Set the provider key in the private server environment only.
# Start in test mode; use production only after validating the actual provider account.
SPOTPLAYER_API_KEY=
SPOTPLAYER_MODE=test
SPOTPLAYER_MAX_ACTIVE_DEVICES=1
SPOTPLAYER_WEB_APP_DEVICES=1
SPOTPLAYER_WEB_PLAYER_SCRIPT=https://app.spotplayer.ir/assets/js/app-api.js?3c52cbebf58fefff5df91e509879fc66

# Default account email for the dedicated SEO specialist role.
SEO_SPECIALIST_EMAIL=seo@sheykhan.com

# Required when intentionally seeding demo accounts outside local/testing; never commit a real value.
# Setting this enables the role-login panel by default; SHOW_TEST_ACCOUNTS=false hides it.
SEED_USER_PASSWORD=

# Optional override for the role-login panel.
# SHOW_TEST_ACCOUNTS=false

# Import exactly the verified 55 legacy students only when intentionally enabled.
# Keep the original SQL outside public/ and outside Git; dry-run before --apply.
SHEYKHAN_IMPORT_LEGACY_STUDENTS=false
SHEYKHAN_LEGACY_STUDENTS_SQL_PATH=storage/app/private/legacy-students.sql
SHEYKHAN_LEGACY_ACADEMY_ID=
# Temporary password for the 54 verified bcrypt accounts; set only in the private .env.
# First login is forced to a dedicated password-change screen.
SHEYKHAN_LEGACY_STUDENT_TEMP_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=failover
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
